generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Product {
  id            String    @id @default(cuid())
  gtin          String    @unique
  title         String
  brand         String
  category      String
  categoryName  String?
  imageUrl      String?
  shopName      String?
  sourceType    String    @default("seed")
  affiliateUrl  String?
  isActive      Boolean   @default(true)
  price         Decimal?  @db.Decimal(10, 2)
  /// Original (pre-discount) price in CHF — e.g. <g:price> vs <g:sale_price>.
  /// Used to compute discount % for the "Price Drops" homepage section.
  originalPriceChf Decimal? @db.Decimal(10, 2)
  embedding     String?   @db.Text
  /// The vector column exists in DB but is managed via raw SQL only.
  /// Prisma cannot serialize pgvector types, so we exclude it from the model.
  // embedding_vec — excluded, use raw SQL: SELECT embedding_vec FROM "Product"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prices Price[]
  alerts UserAlert[]

  @@index([brand])
  @@index([category])
  @@index([categoryName])
  @@index([gtin])
  @@index([sourceType])
  @@index([isActive])
  @@index([price])
  @@index([updatedAt])
  @@index([isActive, category])
  @@index([isActive, price])
  @@index([originalPriceChf])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([slug])
}

model Price {
  id        String   @id @default(cuid())
  productId String
  amountChf Decimal  @db.Decimal(10, 2)
  amountEur Decimal  @db.Decimal(10, 2)
  sourceId  String
  shopName  String?
  url       String?
  timestamp DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceId])
  @@index([productId, timestamp])
  @@index([sourceId])
}

model UserAlert {
  id          String   @id @default(cuid())
  email       String
  productId   String
  targetPrice Decimal  @db.Decimal(10, 2)
  isNotified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([productId])
  @@index([isActive, isNotified])
  @@unique([email, productId])
}

model ImportLog {
  id         String   @id @default(cuid())
  feedId     String   @default("xxl_parfum")
  currentSkip Int     @default(0)
  totalItems  Int     @default(0)
  imported    Int     @default(0)
  errors      Int     @default(0)
  status      String  @default("running")
  message     String?
  createdAt   DateTime @default(now())

  @@index([feedId])
  @@index([createdAt])
}
