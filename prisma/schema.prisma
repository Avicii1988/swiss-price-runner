generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Product {
  id            String    @id @default(cuid())
  gtin          String    @unique
  title         String
  brand         String
  category      String
  categoryName  String?
  imageUrl      String?
  shopName      String?
  sourceType    String    @default("seed")
  affiliateUrl  String?
  isActive      Boolean   @default(true)
  price         Decimal?  @db.Decimal(10, 2)
  /// Original (pre-discount) price in CHF — e.g. <g:price> vs <g:sale_price>.
  /// Used to compute discount % for the "Price Drops" homepage section.
  originalPriceChf Decimal? @db.Decimal(10, 2)
  /// Shipping cost to Switzerland in CHF as declared by the feed.
  /// NULL  = unknown      (UI: "Versand auf Anfrage")
  /// 0     = free         (UI: "Versand inkl.")
  /// >0    = paid         (UI: "+ CHF X Versand")
  shippingCostChf Decimal? @db.Decimal(10, 2)
  /// True if `price` is NET (ex-VAT) — rare; most retail feeds ship gross.
  /// When true the UI applies 8.1% Swiss VAT before displaying.
  priceIsNet Boolean @default(false)
  /// Variant grouping key. All sizes of the same product (e.g. 30 / 50 / 100 ml)
  /// share the same groupId. NULL = ungrouped (single-variant product).
  /// Computed during import from brand + baseTitle (size-stripped).
  groupId   String?
  /// Title with the size suffix stripped, used as the grouping signal
  /// AND for SEO-friendly variant headings. Example: "Dior Sauvage EDP".
  baseTitle String?
  /// Extracted size label, kept for the variant selector on the PDP.
  /// Example: "50 ml", "100 ml", "Gr. 42". NULL if no size detected.
  sizeLabel String?
  /// Merchant description text from the feed (`g:description`). Persisted
  /// so the recategorize runner can re-scan keywords against the richer
  /// marketing copy, not just the (often truncated) product title.
  /// Capped at 2000 chars during import.
  description String?   @db.Text
  /// Extracted product attributes as a JSON object. Populated by the
  /// importer's attribute parser so the PDP can render the two-level
  /// variant selector without re-parsing at read time.
  /// Shape: { storage?: "256 GB", color?: "Black", size?: "42", volume?: "50 ml", … }
  displayAttributes String? @db.Text
  embedding     String?   @db.Text
  /// The vector column exists in DB but is managed via raw SQL only.
  /// Prisma cannot serialize pgvector types, so we exclude it from the model.
  // embedding_vec — excluded, use raw SQL: SELECT embedding_vec FROM "Product"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prices Price[]
  alerts UserAlert[]

  @@index([brand])
  @@index([category])
  @@index([categoryName])
  @@index([gtin])
  @@index([sourceType])
  @@index([isActive])
  @@index([price])
  @@index([updatedAt])
  @@index([isActive, category])
  @@index([isActive, price])
  @@index([originalPriceChf])
  @@index([groupId])
  @@index([isActive, groupId])
  // Composite index that covers the new subcategory query exactly:
  // WHERE isActive = true AND category IN (…) ORDER BY price DESC.
  // Postgres walks this index for both the IN-filter AND the sort
  // without an extra heap read — typical category page drops from
  // ~200 ms to <30 ms on a 40 k-row catalogue.
  @@index([isActive, category, price])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([slug])
}

model Price {
  id        String   @id @default(cuid())
  productId String
  amountChf Decimal  @db.Decimal(10, 2)
  amountEur Decimal  @db.Decimal(10, 2)
  sourceId  String
  shopName  String?
  url       String?
  timestamp DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceId])
  @@index([productId, timestamp])
  @@index([sourceId])
}

model UserAlert {
  id          String   @id @default(cuid())
  email       String
  productId   String
  targetPrice Decimal  @db.Decimal(10, 2)
  isNotified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([productId])
  @@index([isActive, isNotified])
  @@unique([email, productId])
}

model ImportLog {
  id         String   @id @default(cuid())
  feedId     String   @default("xxl_parfum")
  currentSkip Int     @default(0)
  totalItems  Int     @default(0)
  imported    Int     @default(0)
  errors      Int     @default(0)
  status      String  @default("running")
  message     String?
  createdAt   DateTime @default(now())

  @@index([feedId])
  @@index([createdAt])
}
